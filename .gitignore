# =============================================================================
# DSO183 custom firmware — .gitignore
#
# Keep the source tree clean. Nothing here is hand-written project material;
# everything ignored is regenerated by the build or captured at bench time.
# =============================================================================

# --- Build artefacts (GNU Make + arm-none-eabi-gcc) -------------------------
build/
*.bin
*.elf
*.hex
*.map
*.o
*.d

# --- Python ----------------------------------------------------------------
__pycache__/
*.pyc
*.pyo

# --- Logs, evidence and bench captures (machine-specific, not source) ------
logs/
evidence/

# --- Reverse-engineering workspace (Gidra project, not firmware source) -----
ghidra-mcp/

# --- Editor / OS -----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Local, non-shared configuration ---------------------------------------
# User-specific paths/hostnames live here, never in the repo.
.local/
.env

# --- Release ---------------------------------------------------------------
# Tagged releases are created on GitHub, not committed here.
*.tar.gz
*.zip
